# RailSync Backend Environment Variables
# Copy this file to .env and fill in values as you get them.
# The app runs correctly with ALL of these blank — features upgrade
# automatically once you add each key.

# --- LLM narration via OpenRouter ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_TIMEOUT_SECONDS=15
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=3

# --- Firebase (decision log) ---
FIREBASE_ENABLED=false
# Local development: point to your downloaded service account file
FIREBASE_CREDENTIALS_PATH=./firebase-key.json
# Production (Railway etc): paste the ENTIRE JSON file content as one
# line here instead — leave FIREBASE_CREDENTIALS_PATH as-is, this one
# takes priority when set
FIREBASE_CREDENTIALS_JSON=

# --- App settings ---
DELAY_MODEL_ENABLED=true
SIMULATION_TICK_SECONDS=2
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
