# RailSync Backend Environment Variables

# Optional LLM explanation layer. Keep credentials in the process environment.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_TIMEOUT_SECONDS=15


# Firebase decision log
FIREBASE_ENABLED=true
FIREBASE_CREDENTIALS_PATH=./firebase-key.json
FIREBASE_CREDENTIALS_JSON=

# App settings
DELAY_MODEL_ENABLED=true
SIMULATION_TICK_SECONDS=2
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
